{
  "name": "ddo-code-flow",
  "displayName": "Ddo-Code-Flow",
  "description": "查看 ddo-code-flow 流水的只读插件：运行中流水（存活流水）、本项目已收口 run 与全局历史——三源聚合数据面",
  "version": "1.1.0",
  "license": "MIT",
  "publisher": "djhhh",
  "repository": {
    "type": "git",
    "url": "https://github.com/Djhhhhhh/Ddo-Code-Flow"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ddo-flow",
          "title": "Ddo-Code-Flow",
          "icon": "media/icons/activity.svg"
        }
      ]
    },
    "views": {
      "ddo-flow": [
        {
          "id": "ddo-flow.runs",
          "name": "存活流水"
        }
      ]
    },
    "commands": [
      {
        "command": "ddo-flow.refresh",
        "title": "刷新存活流水",
        "icon": "$(refresh)"
      },
      {
        "command": "ddo-flow.openRun",
        "title": "查看流水信息",
        "icon": "$(eye)"
      },
      {
        "command": "ddo-flow.searchHistory",
        "title": "历史查询：搜索决策与关键信息",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ddo-flow.refresh",
          "when": "view == ddo-flow.runs",
          "group": "navigation"
        },
        {
          "command": "ddo-flow.searchHistory",
          "when": "view == ddo-flow.runs",
          "group": "navigation"
        }
      ],
      "view/item": [
        {
          "command": "ddo-flow.openRun",
          "when": "view == ddo-flow.runs && viewItem == run",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Ddo-Code-Flow",
      "properties": {
        "ddo-flow.indexPath": {
          "type": "string",
          "default": "~/.ddo/index.json",
          "description": "全局 run 索引文件绝对路径（支持 ~ 前缀）"
        }
      }
    }
  }
}
