{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/artifact-catalog.schema.json",
  "title": "ddo-code-flow artifact role catalog",
  "type": "object",
  "required": ["version", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "file", "dynamic", "description"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["markdown", "json", "text", "code", "dir"]
          },
          "file": {
            "type": ["string", "null"],
            "description": "Path relative to the artifact directory. Null means runtime-resolved."
          },
          "dynamic": {
            "type": "boolean",
            "description": "True when runtime context decides the concrete artifact."
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
