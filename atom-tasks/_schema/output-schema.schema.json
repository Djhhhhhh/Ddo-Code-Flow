{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/output-schema.schema.json",
  "title": "ddo-code-flow output schema",
  "$comment": "定义 atom-task 输出产物的结构规范。支持纯 MD 输出和 JSON+MD 双输出两种模式。每个 .output.schema.json 必须符合此 schema。",
  "type": "object",
  "required": ["description", "outputFormat", "document", "sections"],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "一句话说明此 schema 管控哪个产物文件"
    },
    "outputFormat": {
      "type": "string",
      "enum": ["markdown", "json+markdown"],
      "description": "输出模式：markdown=仅输出 MD 文件；json+markdown=同时输出 JSON 和对应的 MD 文件"
    },
    "templateRef": {
      "type": "string",
      "pattern": "^skill://",
      "description": "可选：引用现有的 _template.md 文件（兼容过渡期使用）"
    },
    "document": { "$ref": "#/$defs/document" },
    "jsonFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/jsonField" },
      "description": "outputFormat=json+markdown 时必填：定义 JSON 文件的字段结构"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" },
      "description": "MD 文件的模块化结构定义，按文档中的出现顺序排列。json+markdown 模式下描述 JSON 到 MD 的渲染规则"
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "全局校验规则，描述 sections 无法表达的约束"
    },
    "example": {
      "type": "string",
      "minLength": 1,
      "description": "一份完整的填充示例，让 agent 直观看到期望输出的格式"
    },
    "fieldDocs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "字段路径到详细说明的映射。键为字段路径（如 'sections[].heading'、'jsonFields[].type'），值为该字段的详细文档说明。用于自动生成字段文档，补充 JSON Schema description 无法表达的约束和用法说明。"
    }
  },
  "$defs": {
    "jsonField": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "JSON 字段名"
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "array", "object"],
          "description": "字段类型"
        },
        "required": {
          "type": "boolean",
          "description": "此字段是否必须存在"
        },
        "description": {
          "type": "string",
          "description": "字段含义说明"
        },
        "example": {
          "description": "字段示例值"
        }
      }
    },
    "document": {
      "type": "object",
      "required": ["title", "titleFormat"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "文档 H1 标题文本"
        },
        "titleFormat": {
          "type": "string",
          "enum": ["固定文本", "动态拼接", "占位符"],
          "description": "标题格式模式：固定文本=原样输出；动态拼接=由多个字段拼接（如 task-{{ NN }} — {{ 标题 }}）；占位符=模板替换（如 {{ 项目名称 }} Specification）"
        },
        "description": {
          "type": "string",
          "description": "标题下方的 blockquote 描述文本（可选）"
        },
        "separators": {
          "type": "boolean",
          "default": false,
          "description": "section 之间是否用 --- 水平线分隔"
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["heading", "level", "required", "format"],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "description": "section 标题文本（不含 # 前缀）"
        },
        "level": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "description": "heading 层级（1=#, 2=##, 3=###, 4=####）"
        },
        "required": {
          "type": "boolean",
          "description": "此 section 是否必须存在"
        },
        "extensible": {
          "type": "boolean",
          "default": false,
          "description": "agent 是否可以在 schema 定义的基础上扩展内容（加列、加项、加子节等）"
        },
        "format": {
          "type": "string",
          "enum": ["text", "list", "table", "structured-list", "group", "template", "prose", "code"],
          "description": "此 section 的内容格式类型"
        },
        "placeholder": {
          "type": "string",
          "description": "format=text 时：占位符文本，agent 需替换为具体内容"
        },
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "format=table 时：表头列名"
        },
        "idPrefix": {
          "type": "string",
          "description": "format=structured-list 时：ID 前缀（如 FR、AC、Q）"
        },
        "idPattern": {
          "type": "string",
          "description": "format=structured-list 时：ID 格式模式（如 FR-{PREFIX}-{N}、AC-{N}）"
        },
        "content": {
          "type": "string",
          "description": "format=template 时：固定文本内容，agent 原样输出"
        },
        "language": {
          "type": "string",
          "description": "format=code 时：代码块语言标识（如 json、bash、typescript）"
        },
        "description": {
          "type": "string",
          "description": "对此 section 的补充说明"
        },
        "subsections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" },
          "description": "format=group 时：子 section 列表"
        }
      }
    }
  }
}
