{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/output-schema.schema.json",
  "title": "ddo-code-flow output schema",
  "type": "object",
  "required": ["description", "outputFormat", "document"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "outputFormat": { "type": "string", "enum": ["json", "markdown", "text"] },
    "templateRef": { "type": "string", "pattern": "^skill://" },
    "document": { "$ref": "#/$defs/document" },
    "jsonFields": { "type": "array", "items": { "$ref": "#/$defs/jsonField" } },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validators": { "type": "array", "items": { "$ref": "#/$defs/validator" } },
    "example": { "type": "string", "minLength": 1 },
    "fieldDocs": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "options": { "type": "object", "additionalProperties": true },
    "documentModes": { "type": "object", "additionalProperties": true },
    "humanReadableFirst": { "type": "boolean" },
    "aiIndexPlacement": { "type": "string" },
    "splitManifest": { "type": "object", "additionalProperties": true },
    "archive": { "type": "object", "additionalProperties": true },
    "staticCheck": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["title", "titleFormat", "description"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "titleFormat": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "separators": { "type": "boolean", "default": false }
      }
    },
    "jsonField": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "array", "object", "null"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "example": {},
        "minLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "type": "string" },
        "enum": { "type": "array" },
        "items": { "type": "object", "additionalProperties": true },
        "properties": { "type": "object", "additionalProperties": true },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "section": {
      "type": "object",
      "required": ["heading", "level", "required", "format"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "enum": [1, 2, 3, 4, 5, 6] },
        "required": { "type": "boolean" },
        "extensible": { "type": "boolean", "default": false },
        "format": { "type": "string", "enum": ["text", "list", "table", "structured-list", "group", "template", "prose", "code"] },
        "placeholder": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "idPrefix": { "type": "string" },
        "idPattern": { "type": "string" },
        "content": { "type": "string" },
        "language": { "type": "string" },
        "description": { "type": "string" },
        "subsections": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/section" },
              { "type": "string", "minLength": 1 }
            ]
          }
        },
        "allowedEvidence": { "type": "array", "items": { "type": "string" } },
        "allowedAdoption": { "type": "array", "items": { "type": "string" } },
        "diagramSyntax": { "type": "string" },
        "candidateSources": { "type": "array", "items": { "type": "string" } },
        "candidateStates": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validator": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["task-group", "worktree-info", "verification-final-result", "verification-group-summary", "code-change-manifest"]
          }
        }
    }
  }
}
