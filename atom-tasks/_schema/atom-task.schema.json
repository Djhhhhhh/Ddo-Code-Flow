{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-swe/atom-task.schema.json",
  "title": "ddo-swe atom-task",
  "$comment": "name must equal the parent directory name; this is enforced by the loader, not by JSON Schema.",
  "type": "object",
  "required": [
    "name",
    "version",
    "stage",
    "description",
    "enabled",
    "io",
    "prompt",
    "confirmation",
    "concurrency",
    "timeoutSec"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "stage": { "$ref": "#/$defs/stageEnum" },
    "description": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "io": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputRef" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputRef" }
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["instruction"],
      "additionalProperties": false,
      "properties": {
        "instruction": { "type": "string", "minLength": 1 },
        "templateRef": { "type": "string", "pattern": "^(skill|run)://" },
        "guardrails": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "required": ["required", "rejectAction"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "rejectAction": {
          "type": "string",
          "enum": ["regenerate-with-feedback", "abort", "skip"]
        }
      }
    },
    "concurrency": {
      "type": "object",
      "required": ["parallelizable"],
      "additionalProperties": false,
      "properties": {
        "parallelizable": { "type": "boolean" }
      }
    },
    "timeoutSec": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "stageEnum": {
      "type": "string",
      "enum": [
        "context",
        "requirement",
        "specification",
        "planning",
        "test-planning",
        "tasking",
        "coding",
        "verification",
        "review",
        "reporting",
        "reflection",
        "done"
      ]
    },
    "inputRef": {
      "type": "object",
      "required": ["ref", "required"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^(skill|run)://" },
        "required": { "type": "boolean" }
      }
    },
    "outputRef": {
      "type": "object",
      "required": ["ref", "kind"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "pattern": "^(skill|run)://" },
        "kind": {
          "type": "string",
          "enum": ["markdown", "json", "text", "code", "dir"]
        }
      }
    }
  }
}
