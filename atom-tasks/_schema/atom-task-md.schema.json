{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/atom-task-md.schema.json",
  "title": "ddo-code-flow atom-task (MD format)",
  "$comment": "定义 .md 文件 YAML frontmatter 的 schema。description 和 prompt.instruction/prompt.guardrails 在 markdown body 中。",
  "type": "object",
  "required": ["name", "version", "stage", "enabled", "io", "confirmation", "concurrency", "timeoutSec"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "原子任务的唯一标识名，必须与所在目录名一致，使用 kebab-case 格式"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "原子任务定义的语义化版本号（semver）"
    },
    "stage": {
      "$ref": "#/$defs/stageEnum",
      "description": "原子任务所属的流水线阶段，决定它在哪个 stage 中被调度"
    },
    "enabled": {
      "type": "boolean",
      "description": "是否启用此原子任务。可通过 config.json 的 atomTaskOverrides 覆盖"
    },
    "io": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": false,
      "description": "输入输出声明：定义此原子任务读取和产出的文件",
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputRef" },
          "description": "输入文件引用列表。ref 使用 skill://（项目根目录）或 run://（工作树）协议"
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputRef" },
          "description": "输出文件引用列表。kind 标记产物格式：markdown / json / text / code / dir"
        }
      }
    },
    "outputSchemaRef": {
      "type": "string",
      "pattern": "^skill://",
      "description": "引用对应的 .output.schema.json 文件路径，定义产物 MD 的结构规范"
    },
    "options": {
      "type": "array",
      "description": "可配置参数列表，用户可在 config.json 的 atomTaskOverrides 中覆盖默认值",
      "items": {
        "type": "object",
        "required": ["key", "type", "default", "label", "description"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "参数键名，使用 camelCase 格式"
          },
          "type": {
            "type": "string",
            "enum": ["boolean", "string", "number"],
            "description": "参数值类型"
          },
          "default": {
            "description": "参数默认值"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "参数的人类可读标签"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "参数的详细说明"
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "required": ["required", "rejectAction"],
      "additionalProperties": false,
      "description": "用户确认配置：决定任务完成后是否需要用户确认",
      "properties": {
        "required": {
          "type": "boolean",
          "description": "任务完成后是否需要用户明确确认才能进入下一阶段"
        },
        "rejectAction": {
          "type": "string",
          "enum": ["regenerate-with-feedback", "abort", "skip"],
          "description": "用户拒绝时的处理方式：regenerate-with-feedback=带反馈重生成；abort=终止流水线；skip=跳过此任务"
        }
      }
    },
    "concurrency": {
      "type": "object",
      "required": ["parallelizable"],
      "additionalProperties": false,
      "description": "并发配置",
      "properties": {
        "parallelizable": {
          "type": "boolean",
          "description": "此原子任务是否可与其他任务并行执行"
        }
      }
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 0,
      "description": "任务超时时间（秒）。0 表示不限时"
    }
  },
  "$defs": {
    "stageEnum": {
      "type": "string",
      "enum": [
        "context",
        "requirement",
        "specification",
        "planning",
        "test-planning",
        "tasking",
        "coding",
        "verification",
        "review",
        "reporting",
        "reflection",
        "done"
      ],
      "description": "流水线阶段枚举"
    },
    "inputRef": {
      "type": "object",
      "required": ["ref", "required"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(skill|run)://",
          "description": "文件引用路径，使用 skill:// 或 run:// 协议"
        },
        "required": {
          "type": "boolean",
          "description": "此输入是否必须存在"
        }
      }
    },
    "outputRef": {
      "type": "object",
      "required": ["ref", "kind"],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(skill|run)://",
          "description": "文件输出路径，使用 skill:// 或 run:// 协议"
        },
        "kind": {
          "type": "string",
          "enum": ["markdown", "json", "text", "code", "dir"],
          "description": "产物格式类型"
        }
      }
    }
  }
}
