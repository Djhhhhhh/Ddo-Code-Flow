{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/atom-task-md.schema.json",
  "title": "ddo-code-flow atom-task v4 (MD frontmatter)",
  "$comment": "v4 atom-tasks declare only their own capability: produced artifact roles, consumed artifact roles, options, concurrency, timeout, and reject behavior. Pipeline is the only integration layer.",
  "type": "object",
  "required": [
    "name",
    "version",
    "enabled",
    "produces",
    "confirmation",
    "concurrency",
    "timeoutSec"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique atom-task name. It must match the directory and file name."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "enabled": {
      "type": "boolean",
      "description": "Default enablement. Workflows or project config may override it."
    },
    "produces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/produceRef" },
      "description": "Artifact roles this atom-task can publish to the runtime blackboard."
    },
    "consumes": {
      "type": "array",
      "items": { "$ref": "#/$defs/consumeRef" },
      "description": "Artifact roles this atom-task asks the runtime to inject."
    },
    "outputSchemaRef": {
      "type": "string",
      "pattern": "^skill://",
      "description": "Optional schema for the primary generated document."
    },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/optionDef" }
    },
    "confirmation": {
      "type": "object",
      "required": ["rejectAction"],
      "additionalProperties": false,
      "properties": {
        "rejectAction": {
          "type": "string",
          "enum": ["regenerate-with-feedback", "abort", "skip"]
        }
      }
    },
    "concurrency": {
      "type": "object",
      "required": ["parallelizable"],
      "additionalProperties": false,
      "properties": {
        "parallelizable": { "type": "boolean" }
      }
    },
    "timeoutSec": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "artifactRole": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "artifactKind": {
      "type": "string",
      "enum": ["markdown", "json", "text", "code", "dir"]
    },
    "produceRef": {
      "type": "object",
      "required": ["role", "kind"],
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/artifactRole" },
        "kind": { "$ref": "#/$defs/artifactKind" },
        "primary": {
          "type": "boolean",
          "description": "Marks the stage's main artifact when a task produces more than one role."
        }
      }
    },
    "consumeRef": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/artifactRole" },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "optionDef": {
      "type": "object",
      "required": ["key", "type", "default", "label", "description"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "camelCase option key."
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "string", "number", "integer", "array"]
        },
        "default": {},
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
