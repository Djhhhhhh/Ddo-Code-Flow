<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  body { margin:0; font-family: system-ui,-apple-system,'PingFang SC','Microsoft YaHei',sans-serif; }
  .card { width:1080px; height:1440px; box-sizing:border-box; background:#FFFFFF; padding:96px 84px; display:flex; flex-direction:column; }
  .kicker { font-size:26px; color:#6B7280; letter-spacing:2px; }
  h1 { margin:18px 0 0; font-size:72px; line-height:1.25; color:#111827; }
  .hooks { margin-top:48px; }
  .hooks p { margin:0 0 20px; font-size:34px; color:#4B5563; }
  .nums { margin-top:auto; display:flex; gap:28px; }
  .num { flex:1; text-align:center; padding:44px 0; border-radius:24px; }
  .num b { display:block; font-size:92px; font-weight:800; }
  .num span { display:block; margin-top:8px; font-size:26px; color:#6B7280; }
  .b { background:#F8FAFC; border:1px solid #E2E8F0; } .b b { color:#111827; }
  .d { background:#EFF6FF; border:1px solid #DBEAFE; } .d b { color:#2563EB; }
  .foot { margin-top:36px; font-size:22px; color:#9CA6AF; }
</style></head><body>
<div class="card">
<p class="kicker">同模型 A/B 对照</p>
<h1>{{title}}</h1>
<div class="hooks">
<p>· {{hook1}}</p>
<p>· {{hook2}}</p>
<p>· {{hook3}}</p>
</div>
<div class="nums">
<div class="num b"><b>{{baselineRate}}</b><span>纯 prompt 达标</span></div>
<div class="num d"><b>{{ddoRate}}</b><span>+ Ddo-Code-Flow 达标</span></div>
</div>
<p class="foot">{{footer}}</p>
</div>
</body></html>
