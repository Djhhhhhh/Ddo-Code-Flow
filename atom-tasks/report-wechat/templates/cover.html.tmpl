<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<!-- 视觉标准 = eval/bench/docs/report-design.md（改风格先改文档）；粘贴安全：全内联、无 div/class/style 标签 -->
<body style="margin:0;font-family:system-ui,-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;background:#0A0D0F;">
<section style="width:900px;height:383px;box-sizing:border-box;padding:40px 46px;background:#0A0D0F;background-image:radial-gradient(rgba(255,255,255,0.07) 1px,transparent 1px);background-size:40px 40px;">
<p style="margin:0;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:13px;letter-spacing:3px;color:#5EEAD4;"><span leaf="">同模型 A/B 对照 · MODEL QUICK EVAL</span></p>
<p style="margin:12px 0 22px;font-size:28px;line-height:1.35;font-weight:700;color:#F5F7F8;"><span leaf="">{{title}}</span></p>
<section style="display:flex;gap:18px;">
<section style="flex:1;text-align:center;padding:22px 0;background:#14171C;border:1px solid #2A3138;border-radius:12px;">
<p style="margin:0;font-size:42px;font-weight:800;color:#F5F7F8;"><span leaf="">{{baselineRate}}</span></p>
<p style="margin:5px 0 0;font-size:14px;color:#8A949C;"><span leaf="">纯 prompt 达标</span></p>
</section>
<section style="flex:1;text-align:center;padding:22px 0;background:#0E2622;border:1px solid #2A5B50;border-radius:12px;">
<p style="margin:0;font-size:42px;font-weight:800;color:#5EEAD4;"><span leaf="">{{ddoRate}}</span></p>
<p style="margin:5px 0 0;font-size:14px;color:#8A949C;"><span leaf="">+ Ddo-Code-Flow 达标</span></p>
</section>
</section>
<p style="margin:18px 0 0;font-size:12px;color:#8A949C;"><span leaf="">{{subtitle}}</span></p>
<p style="margin:12px 0 0;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;color:#5C6670;"><span leaf="">{{brand}}</span></p>
</section>
</body></html>
