<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<body style="margin:0;font-family:system-ui,-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;background:#FFFFFF;">
<section style="width:900px;height:383px;box-sizing:border-box;padding:44px 48px;background:#FFFFFF;">
<p style="margin:0 0 6px;font-size:14px;color:#6B7280;"><span leaf="">同模型 A/B 对照 · 公众号封面</span></p>
<p style="margin:0 0 18px;font-size:28px;line-height:1.35;font-weight:700;color:#111827;"><span leaf="">{{title}}</span></p>
<section style="display:flex;gap:24px;">
<section style="flex:1;text-align:center;padding:26px 0;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:14px;">
<p style="margin:0;font-size:46px;font-weight:800;color:#111827;"><span leaf="">{{baselineRate}}</span></p>
<p style="margin:6px 0 0;font-size:15px;color:#6B7280;"><span leaf="">纯 prompt 达标</span></p>
</section>
<section style="flex:1;text-align:center;padding:26px 0;background:#EFF6FF;border:1px solid #DBEAFE;border-radius:14px;">
<p style="margin:0;font-size:46px;font-weight:800;color:#2563EB;"><span leaf="">{{ddoRate}}</span></p>
<p style="margin:6px 0 0;font-size:15px;color:#6B7280;"><span leaf="">+ Ddo-Code-Flow 达标</span></p>
</section>
</section>
<p style="margin:16px 0 0;font-size:13px;color:#9CA6AF;"><span leaf="">{{subtitle}}</span></p>
</section>
</body></html>
