{
  "description": "详细技术 Plan 输出规范；支持 single 和 split 两种文档模式，并可派生简化归档文档。",
  "outputFormat": "markdown",
  "options": {
    "split-threshold": {
      "type": "integer",
      "default": 12000,
      "minimum": 4000,
      "countUnit": "normalized LF Unicode code point"
    }
  },
  "documentModes": {
    "single": {
      "condition": "draftCodePoints <= split-threshold",
      "entry": "plan.md",
      "partsDirectory": null,
      "rules": [
        "plan.md 包含完整详细 Plan",
        "不创建 plans/",
        "不得把旧分册标记为 current"
      ]
    },
    "split": {
      "condition": "draftCodePoints > split-threshold",
      "entry": "plan.md",
      "partsDirectory": "plans/",
      "partPattern": "plans/NN-<semantic-slug>.md",
      "rules": [
        "plan.md 是稳定入口和唯一确认入口",
        "manifest 列出全部 current parts、职责、字符数和 revision",
        "按语义拆分，不切断 Markdown 表格、Mermaid、Decision、接口、schema 或 DDL 契约",
        "旧 revision 分册必须移出 current 集合或标记 stale"
      ]
    }
  },
  "document": {
    "title": "{{ 项目名称 }} 技术 Plan",
    "titleFormat": "占位符",
    "description": "以仓库事实、技术决策和实现契约指导 Test-Planning、Tasking、Coding、Verification 与 Review。",
    "separators": true
  },
  "humanReadableFirst": true,
  "aiIndexPlacement": "table-last-column-or-paragraph-tail",
  "sections": [
    {
      "heading": "执行摘要",
      "level": 2,
      "required": true,
      "format": "prose",
      "description": "说明目标、范围、关键结论、文档模式和 revision。"
    },
    {
      "heading": "范围与非目标",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "事项",
        "说明",
        "AI 索引"
      ],
      "description": "只覆盖当前仓库/服务和直接依赖；不写人员、排期或无关服务内部设计。"
    },
    {
      "heading": "现有设计与复用基线",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "能力",
        "文件路径",
        "符号",
        "证据类型",
        "采用方式",
        "适用边界",
        "AI 索引"
      ],
      "allowedEvidence": [
        "Repository Fact",
        "Assumption"
      ],
      "allowedAdoption": [
        "复用现有实现",
        "扩展现有实现",
        "新增实现",
        "不适用"
      ]
    },
    {
      "heading": "整体架构与流程",
      "level": 2,
      "required": true,
      "format": "group",
      "diagramSyntax": "Mermaid flowchart",
      "description": "仅描述当前改动直接相关的参与方、边界和主/异常流程。"
    },
    {
      "heading": "技术选型与方案对比",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "方案",
        "来源",
        "仓库适配性",
        "代价与风险",
        "状态",
        "结论",
        "AI 索引"
      ],
      "candidateSources": [
        "初始 Plan",
        "用户修改"
      ],
      "candidateStates": [
        "candidate",
        "accepted",
        "rejected",
        "superseded"
      ],
      "description": "只比较真实候选，不强制凑方案数量。"
    },
    {
      "heading": "数据模型设计",
      "level": 2,
      "required": true,
      "format": "group",
      "subsections": [
        "实体与字段",
        "schema 与 DDL（如适用）",
        "状态与不变量",
        "迁移、兼容与回滚"
      ]
    },
    {
      "heading": "API 接口设计",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "接口/入口",
        "请求",
        "响应",
        "错误与幂等",
        "复用标准",
        "实现职责",
        "AI 索引"
      ]
    },
    {
      "heading": "算法设计",
      "level": 2,
      "required": true,
      "format": "group",
      "description": "仅对非平凡逻辑说明输入、输出、不变量、步骤、复杂度和边界；不得提供逐行实现。"
    },
    {
      "heading": "文件变更计划",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "文件/目录",
        "变更职责",
        "复用或依赖",
        "AI 索引"
      ]
    },
    {
      "heading": "兼容、稳定性与回滚",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "关注点",
        "适用性",
        "设计/理由",
        "回滚信号",
        "AI 索引"
      ]
    },
    {
      "heading": "Verification Anchor",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "需验证契约",
        "可观察结果",
        "证据位置",
        "AI 索引"
      ],
      "description": "只交付验证锚点，不生成测试用例或 test-plan。"
    },
    {
      "heading": "开放问题与 Spec 对应",
      "level": 2,
      "required": true,
      "format": "table",
      "columns": [
        "问题",
        "确定答案或阻塞原因",
        "解决位置",
        "AI 索引"
      ]
    },
    {
      "heading": "风险与下游交接",
      "level": 2,
      "required": true,
      "format": "group",
      "description": "说明风险、缓解、Tasking/Coding 读取范围和事实失效处理。"
    },
    {
      "heading": "用户确认",
      "level": 2,
      "required": true,
      "format": "list",
      "commands": [
        "同意",
        "修改：<反馈>",
        "提问：<问题>",
        "归档",
        "归档：<模板名>"
      ]
    }
  ],
  "splitManifest": {
    "heading": "Parts Manifest",
    "requiredWhen": "documentMode == split",
    "columns": [
      "#",
      "文档",
      "职责",
      "字符数",
      "状态",
      "AI 索引"
    ],
    "currentStatus": "current",
    "staleStatus": "stale"
  },
  "archive": {
    "listCommand": "归档",
    "generateCommand": "归档：<模板名>",
    "templatesDirectory": "atom-tasks/plan/references/",
    "templatePattern": "*.md",
    "selectionMode": "exact filename or basename",
    "selectionRules": [
      "归档 only lists available template names and does not generate output",
      "归档：<模板名> resolves only within templatesDirectory",
      "directory segments, wildcards, and traversal paths are rejected",
      "template content, external source path, and hash are not validated",
      "the selected template is read-only during archive generation"
    ],
    "output": "tech-design.md",
    "source": "current detailed Plan revision",
    "recordInOutput": [
      "template name",
      "Plan revision"
    ],
    "drivesDownstream": false,
    "staleWhenPlanRevisionChanges": true
  },
  "staticCheck": {
    "scope": "Markdown and Mermaid structure only",
    "maxExecutionsPerRevision": 1,
    "autoRetry": false,
    "reloadContextOnFailure": false,
    "failureTypes": [
      "content_error",
      "checker_execution_error"
    ]
  },
  "rules": [
    "数据模型设计必须位于 API 接口设计之前，API 接口设计必须位于算法设计之前",
    "FR/AC/DEC/Q 等 AI 索引不得作为表格第一列",
    "所有正式图使用 Mermaid 流程图语法",
    "Plan 不承担完整测试计划职责",
    "不得新增 Plan 专属验证脚本"
  ]
}
