{
  "$schema": "./config.schema.json",
  "version": "3.0.0",
  "base": {
    "targetDir": "..",
    "contextPaths": [],
    "contextOptional": true,
    "respGenerator": {
      "maxLength": 32,
      "case": "kebab",
      "stripStopwords": true
    },
    "metrics": {
      "enabled": false,
      "provider": "tokscale",
      "failurePolicy": "warn",
      "report": {
        "enabled": true,
        "path": "metrics-report.md"
      },
      "pricing": {
        "model": "",
        "inputPerMillionUsd": 0,
        "outputPerMillionUsd": 0
      }
    }
  },
  "workflows": {
    "default": "standard",
    "selection": {
      "allowUserOverride": true,
      "argumentNames": ["workflow", "mode", "profile"],
      "rules": [
        {
          "workflow": "guarded",
          "matchAny": [
            "安全",
            "security",
            "prototype",
            "数据迁移",
            "migration",
            "公开接口",
            "public api",
            "性能",
            "performance",
            "并发",
            "concurrency",
            "async",
            "race"
          ]
        },
        {
          "workflow": "lightweight",
          "matchAny": [
            "docs",
            "documentation",
            "readme",
            "文档",
            "调研",
            "research",
            "小修",
            "small fix",
            "minor fix"
          ]
        },
        { "workflow": "standard", "fallback": true }
      ]
    },
    "items": [
      { "id": "lightweight", "name": "Lightweight", "path": "workflows/lightweight.json" },
      { "id": "standard", "name": "Standard", "path": "workflows/standard.json" },
      { "id": "guarded", "name": "Guarded", "path": "workflows/guarded.json" }
    ]
  },
  "atomTaskOverrides": {}
}
