{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow.dev/eval/private-verifier.schema.json",
  "title": "Private verifier manifest",
  "type": "object",
  "required": ["schemaVersion", "taskId", "command"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "minLength": 3 },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "bootstrapFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "sha256"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
