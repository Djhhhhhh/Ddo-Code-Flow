<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
  body { margin:0; font-family: system-ui, -apple-system; background:#fff; color:#1f2937; }
  .wrap { width:677px; margin:0 auto; padding:32px 24px; }
  h1 { font-size:24px; text-align:center; margin-bottom:6px; }
  .sub { text-align:center; color:#6b7280; font-size:13px; margin-bottom:24px; }
  .num { display:flex; gap:16px; margin:20px 0; }
  .card { flex:1; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:14px; text-align:center; }
  .card .v { font-size:26px; font-weight:700; }
  .card b.hl { color:#2563eb; }
  img { width:100%; border-radius:10px; margin:10px 0; }
  blockquote { background:#fffbeb; border-left:4px solid #f59e0b; margin:12px 0; padding:10px 14px; font-size:12px; color:#78350f; }
</style></head><body><div class="wrap">
<h1>{{title}}</h1>
<div class="sub">{{subtitle}}</div>
<div class="num">
  <div class="card"><div class="v">{{baselineRate}}</div>纯 prompt</div>
  <div class="card"><div class="v"><b class="hl">{{ddoRate}}</b></div>+ Ddo-Code-Flow</div>
</div>
<img src="{{shotBaseline}}">
<img src="{{shotDdo}}">
<p>{{keyPoints}}</p>
<blockquote>{{declarations}}</blockquote>
</div></body></html>
