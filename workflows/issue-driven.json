{
  "$schema": "../config.schema.json#/$defs/workflowDefinition",
  "id": "issue-driven",
  "version": "1.0.0",
  "name": "Issue Driven",
  "description": "Issue/PR 驱动开发流水线：认领 issue → 远端确认门 → 交付 PR。",
  "descriptionEn": "Issue/PR driven pipeline: fetch issue → remote gates → deliver PR.",
  "descriptionZh": "Issue/PR 驱动开发流水线：认领 issue → 远端确认门 → 交付 PR。",
  "confirmationGates": ["spec", "planning", "test-plan"],
  "pipeline": [
    {
      "stage": "context",
      "description": "读取项目上下文。",
      "enabled": true,
      "atomTasks": {
        "entry": ["context"],
        "nodes": {
          "context": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "requirement",
      "description": "认领 issue 并拉取内容，创建工作树。",
      "enabled": true,
      "atomTasks": {
        "entry": ["issue-fetch"],
        "nodes": {
          "issue-fetch": { "next": ["requirement"], "parallelApprove": false, "parallelWith": [] },
          "requirement": { "next": ["git-worktree"], "parallelApprove": false, "parallelWith": [] },
          "git-worktree": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "spec",
      "description": "生成 spec.md，通过远端确认门审核。",
      "enabled": true,
      "atomTasks": {
        "entry": ["spec"],
        "nodes": {
          "spec": { "next": ["remote-gate-spec"], "parallelApprove": false, "parallelWith": [] },
          "remote-gate-spec": { "taskRef": "remote-gate", "options": { "stageName": "spec" }, "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "planning",
      "description": "生成 plan.md，通过远端确认门审核。",
      "enabled": true,
      "atomTasks": {
        "entry": ["plan"],
        "nodes": {
          "plan": { "next": ["remote-gate-plan"], "parallelApprove": false, "parallelWith": [] },
          "remote-gate-plan": { "taskRef": "remote-gate", "options": { "stageName": "planning" }, "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "test-plan",
      "description": "生成 test-plan.md，通过远端确认门审核。",
      "enabled": true,
      "atomTasks": {
        "entry": ["test-plan"],
        "nodes": {
          "test-plan": { "next": ["remote-gate-test-plan"], "parallelApprove": false, "parallelWith": [] },
          "remote-gate-test-plan": { "taskRef": "remote-gate", "options": { "stageName": "test-plan" }, "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "tasking",
      "description": "拆分任务。",
      "enabled": true,
      "atomTasks": {
        "entry": ["tasking"],
        "nodes": {
          "tasking": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "coding",
      "description": "执行编码，支持自检轮次和模型路由。",
      "enabled": true,
      "atomTasks": {
        "entry": ["coding"],
        "nodes": {
          "coding": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "verification",
      "description": "验收，支持重试次数。",
      "enabled": true,
      "atomTasks": {
        "entry": ["verification"],
        "nodes": {
          "verification": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "delivery",
      "description": "交付文档 + 创建 PR。",
      "enabled": true,
      "atomTasks": {
        "entry": ["delivery-doc"],
        "nodes": {
          "delivery-doc": { "next": ["create-pr"], "parallelApprove": false, "parallelWith": [] },
          "create-pr": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    },
    {
      "stage": "cleanup",
      "description": "安全清理 worktree；完成后由 runtime 进入 done 终态。",
      "enabled": true,
      "atomTasks": {
        "entry": ["cleanup-worktree"],
        "nodes": {
          "cleanup-worktree": { "next": [], "parallelApprove": false, "parallelWith": [] }
        }
      }
    }
  ],
  "atomTaskOverrides": {
    "test-plan": { "enabled": true, "tdd": true }
  }
}
