{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddo-code-flow/config.schema.json",
  "title": "ddo-code-flow config",
  "$comment": "Reference existence (atom-task names) and DAG no-cycle are enforced by the loader (UI schema.js + dag.js, and the Agent's runtime). They are NOT expressible in pure JSON Schema.",
  "type": "object",
  "required": ["version", "base", "atomTaskOverrides"],
  "oneOf": [
    { "required": ["pipeline"] },
    { "required": ["workflows"] }
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "base": {
      "type": "object",
      "required": [
        "targetDir",
        "contextPaths",
        "contextOptional",
        "respGenerator",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "targetDir": { "type": "string", "minLength": 1 },
        "contextPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "contextOptional": { "type": "boolean" },
        "respGenerator": {
          "type": "object",
          "required": ["maxLength", "case", "stripStopwords"],
          "additionalProperties": false,
          "properties": {
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 128 },
            "case": { "type": "string", "enum": ["kebab", "snake", "camel"] },
            "stripStopwords": { "type": "boolean" }
          }
        },
        "confirmationGates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "metrics": {
          "type": "object",
          "required": ["enabled", "provider", "failurePolicy", "report", "pricing"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": {
              "type": "string",
              "enum": [
                "tokscale",
                "custom-command",
                "cursor-session-counter",
                "cursor-sdk"
              ]
            },
            "failurePolicy": {
              "type": "string",
              "enum": ["warn", "fail"]
            },
            "report": {
              "type": "object",
              "required": ["enabled", "path"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "minLength": 1 }
              }
            },
            "pricing": {
              "type": "object",
              "required": [
                "model",
                "inputPerMillionUsd",
                "outputPerMillionUsd"
              ],
              "additionalProperties": false,
              "properties": {
                "model": { "type": "string" },
                "inputPerMillionUsd": { "type": "number", "minimum": 0 },
                "outputPerMillionUsd": { "type": "number", "minimum": 0 }
              }
            },
            "customCommand": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "description", "atomTasks"],
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "enabled": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "atomTasks": {
            "type": "object",
            "required": ["entry", "nodes"],
            "additionalProperties": false,
            "properties": {
              "entry": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "nodes": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["next", "parallelApprove"],
                  "additionalProperties": false,
                  "properties": {
                    "next": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "parallelApprove": { "type": "boolean" },
                    "parallelWith": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "required": ["default", "items"],
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "selection": {
          "type": "object",
          "required": ["allowUserOverride", "argumentNames", "rules"],
          "additionalProperties": false,
          "properties": {
            "allowUserOverride": { "type": "boolean" },
            "argumentNames": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["workflow"],
                "additionalProperties": false,
                "properties": {
                  "workflow": { "type": "string", "minLength": 1 },
                  "matchAny": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "fallback": { "type": "boolean" }
                }
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "atomTaskOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled"],
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "stageEnum": {
      "type": "string",
      "enum": [
        "context",
        "requirement",
        "spec",
        "planning",
        "test-plan",
        "tasking",
        "coding",
        "verification",
        "review",
        "reporting",
        "reflection",
        "done"
      ]
    },
    "workflowDefinition": {
      "type": "object",
      "required": ["id", "version", "name", "confirmationGates", "pipeline", "atomTaskOverrides"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionZh": { "type": "string" },
        "confirmationGates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "pipeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "description", "atomTasks"],
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "enabled": { "type": "boolean" },
              "description": { "type": "string", "minLength": 1 },
              "atomTasks": {
                "type": "object",
                "required": ["entry", "nodes"],
                "additionalProperties": false,
                "properties": {
                  "entry": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "nodes": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["next", "parallelApprove"],
                      "additionalProperties": false,
                      "properties": {
                        "next": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "parallelApprove": { "type": "boolean" },
                        "parallelWith": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "atomTaskOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": true,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
